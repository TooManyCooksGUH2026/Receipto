# PostgreSQL connection string used by Drizzle and Better Auth
DATABASE_URL=postgres://localhost:5432/receipto

# Better Auth
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173

# Optional: point the browser OCR pipeline at locally hosted Indra OCR models.
# Leave empty to stream the pinned models from Hugging Face on first use.
PUBLIC_INDRA_MODEL_BASE=

# Optional: Overpass API endpoint used by scripts/fetch-osm-shops.ts
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Gemma 4 receipt parsing. Any OpenAI-compatible endpoint works.
# Defaults to OpenRouter; replace the placeholder key with your real key.
GEMMA_API_KEY=replace-with-your-openrouter-api-key
GEMMA_BASE_URL=https://openrouter.ai/api/v1
GEMMA_MODEL=google/gemma-4-31b-it
