{
	"name": "receipto",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node --env-file-if-exists=.env build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed": "tsx scripts/seed.ts",
		"seed:reset": "tsx scripts/seed.ts --reset",
		"osm:fetch": "node scripts/fetch-osm-shops.mjs",
		"copy:ort": "node scripts/copy-ort.mjs",
		"postinstall": "node scripts/copy-ort.mjs",
		"osm:areas": "node scripts/enrich-osm-areas.mjs",
		"db:sync-shops": "node scripts/sync-shop-areas.mjs"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/leaflet": "^1.9.22",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.18",
		"@ducng99/indra-ocr-js": "^0.3.1",
		"@fontsource-variable/montserrat": "^5.3.0",
		"better-auth": "^1.7.18",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"leaflet": "^1.9.4",
		"lucide-svelte": "^1.0.1",
		"onnxruntime-web": "^1.31.1",
		"pg": "^8.23.1"
	},
	"description": "Receipto — a UK food price tracker with on-device receipt OCR, OpenStreetMap stores and SvelteKit.",
	"engines": {
		"node": ">=24"
	}
}
